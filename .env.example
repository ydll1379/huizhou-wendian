# 复制为 .env 并填入你的 key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 高德地图「Web服务」类型 key（lbs.amap.com 控制台免费申请）
AMAP_API_KEY=

# 可选：WeKnora 检索后端（config.yaml 里 retrieval.backend=weknora 时必填）
# 自行部署：git clone https://github.com/Tencent/WeKnora && docker compose up -d
WEKNORA_BASE_URL=http://127.0.0.1:8080
WEKNORA_API_KEY=
